---
import Footer from '../components/Footer.astro';

import { Image } from 'astro:assets';
import logoImg from "../assets/ua_wordmark_line_logo_white_rgb.min.svg";
import 'bootstrap-icons/font/bootstrap-icons.css';

interface Props {
      title: string;
    }

const { title } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const navItems = [
  { name: "Home", href: "/" },
  { name: "Team members", href: "/team" },
  { name: "Loans", href: "/loans" },
  { name: "Archiving", href: "/archiving" },
  { name: "Projects", href: "/projects" },
  { name: "Photos", href: "/photos" },
  { name: "Donate", href: "/donate" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/ico" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
    <title>{title}</title>
 		<link
        href="https://cdn.digital.arizona.edu/lib/arizona-bootstrap/5.0.5/css/arizona-bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-4vD+FDdfLyLw8F7F3H6bQeIeiYYyb1Na6MBtTlGxiOTwWuv6kwVsRbPiXDZhZpZf"
        crossorigin="anonymous"
      >
  </head>
  <body>


<header class="bg-red arizona-header py-2" id="header_arizona">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center">
      <!-- 🔹 UA Logo (left) -->
      <a class="arizona-logo" href="https://www.arizona.edu" title="The University of Arizona homepage">
            <Image class="arizona-line-logo" alt="The University of Arizona Wordmark Line Logo White" src={logoImg} fetchpriority="high" loading="eager" />

      </a>

      <!-- 🔹 Navbar toggler (right, visible on mobile) -->
      <button
        class="navbar-toggler d-lg-none"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarMain"
        aria-controls="navbarMain"
        aria-expanded="false"
        aria-label="Toggle navigation"
      ><i style ="font-size : 30px; color: white; " class="bi bi-list"></i>
        <span class="navbar-toggler-icon"></span>
      </button>
    </div>
  </div>

  <!-- 🔹 Collapsible nav menu (appears below bar when toggled) -->
  <div class="collapse navbar-collapse bg-white" id="navbarMain">
    <div class="container">
      <ul class="navbar-nav ms-auto py-2">
        {navItems.map((item) => (
          <li class="nav-item">
            <a
              href={item.href}
              class:list={["nav-link", "text-dark", { active: currentPath === item.href }]}
              aria-current={currentPath === item.href ? "page" : undefined}
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

<style>
#header_arizona {
  position: relative;
  z-index: 1050;
  overflow: visible;
}

#navbarMain {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  z-index: 1051;
  background-color: white;
  box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
}

#navbarMain .nav-link {
  padding: 0.75rem 0;
}

/* Force white hamburger icon on Arizona red header */
.navbar-toggler {
  border: 0px solid rgba(255, 255, 255, 0.6) !important;
}

.navbar-toggler-icon {
  background-image: none !important;
  position: relative;
  width: 1.5em;
  height: 1.5em;
}

.navbar-toggler-icon::before,
.navbar-toggler-icon::after,
.navbar-toggler-icon div {
  display: block;
  height: 2px;
  width: 100%;
  background-color: white;
  border-radius: 1px;
  position: absolute;
  left: 0;
}

.navbar-toggler-icon div {
  top: 50%;
  transform: translateY(-50%);
}

.navbar-toggler-icon::before {
  top: 0;
}

.navbar-toggler-icon::after {
  bottom: 0;
}
</style>

</header>

    <script
      src="https://cdn.digital.arizona.edu/lib/arizona-bootstrap/5.0.5/js/arizona-bootstrap.bundle.min.js"
      integrity="sha384-2UM6K252KHIGj4zKsAHuK0/0EEXK9rb9ptc+XTh6bc8W8qrpfa1UOAc0B5ehClEl"
      crossorigin="anonymous"
    ></script>

    <slot />
    <Footer/>  
  
  </body>
</html>
