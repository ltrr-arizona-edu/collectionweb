---
import { Image } from 'astro:assets';

import Layout from '../layouts/AZ.astro';
import NavBar from '../components/Navbar.astro';
import TitleBar from '../components/TitleBar.astro'
import PersonnelCard from '../components/PersonnelCard.astro';

import harrelImg from '../assets/people/harrel.jpg';
import brewerImg from '../assets/people/brewer.jpg';
import vanoverImg from '../assets/people/vanover.jpg';
import dotenImg from '../assets/people/doten.jpg';
import hernandezImg from '../assets/people/hernandez.jpg';


import conwayImg from '../assets/people/conway.jpg';
import egurollaImg from '../assets/people/egurolla.jpg';
import harrisonImg from '../assets/people/harrison.jpg';
import rinaImg from '../assets/people/rina.jpg';
import auroraImg from '../assets/people/aurora.jpg';
import bradImg from '../assets/people/brad.jpg';

import johnstonImg from '../assets/people/johnston.jpg';
import emilImg from '../assets/people/emil.jpg';
import armstrongImg from '../assets/people/armstrong.jpg';


import anonImg from '../assets/people/anon.jpg';


const pageTitle = "Team"; 

---

<Layout title={pageTitle}>
<TitleBar/>
<div class="container">
    <NavBar/>
</div>

<div class="container">
    <h2>Personnel</h2>

    <p>The LTRR museum program includes staff and students that work with the collections and archives at LTRR as well as team members based within
        our partner institution the <a href="https://www.nps.gov/orgs/1260/">National Park Service Western Archeological and Conservation Center (WACC)</a>.
    </p>

    <div class="container text-center">
        <div class="row gy-4 align-items-center">



        <!-- CURATION -->

        <PersonnelCard 
            fullname="Peter Brewer" 
            position="Curator" 
            linkHref="https://ltrr.arizona.edu/curator" 
            imgSrc={brewerImg}
            aboveFold={true}/>

        <PersonnelCard 
            fullname="Shannon Harrel" 
            position="Assistant Curator" 
            linkHref="https://ltrr.arizona.edu/person/shannon-harrel" 
            imgSrc={harrelImg}
            aboveFold={true}/>

        <PersonnelCard 
            fullname="Gabriella Vanover" 
            position="Curatorial Assistant" 
            linkHref="https://ltrr.arizona.edu/person/gabriella-vanover-0" 
            imgSrc={vanoverImg}/>

        <PersonnelCard 
            fullname="Stephanie Egurolla" 
            position="Curatorial Assistant" 
            linkHref="https://ltrr.arizona.edu/person/stephanie-egurrola" 
            imgSrc={egurollaImg}/>  

        <PersonnelCard 
            fullname="Austin Doten" 
            position="Student Curatorial Assistant" 
            linkHref="" 
            imgSrc={dotenImg}/>  

        <PersonnelCard 
            fullname="Stephanie Hernandez" 
            position="Student Curatorial Assistant" 
            linkHref="" 
            imgSrc={hernandezImg}/>              

        <!-- CONSERVATION -->

        <PersonnelCard 
            fullname="Alyssa Rina" 
            position="Conservator" 
            linkHref="https://ltrr.arizona.edu/person/alyssa-rina" 
            imgSrc={rinaImg}/>

        <PersonnelCard 
            fullname="Audrey Harrison" 
            position="Conservator" 
            linkHref="https://ltrr.arizona.edu/person/audrey-harrison" 
            imgSrc={harrisonImg}/>            

        <PersonnelCard 
            fullname="Lauren Conway-Hoffman" 
            position="Conservator" 
            linkHref="https://ltrr.arizona.edu/person/lauren-conway" 
            imgSrc={conwayImg}/>    

        <PersonnelCard 
            fullname="Sara Harper" 
            position="Conservation Assistant" 
            linkHref="" 
            imgSrc={anonImg}/> 

        <PersonnelCard 
            fullname="Aurora Levy" 
            position="Student Conservation Assistant" 
            linkHref="" 
            imgSrc={auroraImg}/> 

        <PersonnelCard 
            fullname="Bradley Witchey" 
            position="Student Conservation Assistant" 
            linkHref="" 
            imgSrc={bradImg}/>             

        <!-- ARCHIVES -->

        <PersonnelCard 
            fullname="Jessica Johnston" 
            position="Archivist" 
            linkHref="https://ltrr.arizona.edu/person/jessica-johnston" 
            imgSrc={johnstonImg}/>  

        <PersonnelCard 
            fullname="Bryan Armstrong" 
            position="Archivist" 
            linkHref="" 
            imgSrc={armstrongImg}/>  

        <PersonnelCard 
            fullname="Lisa Martin" 
            position="Archivist" 
            linkHref="" 
            imgSrc={anonImg}/>  

        <PersonnelCard 
            fullname="Erin Vega" 
            position="Student Archival Assistant" 
            linkHref="" 
            imgSrc={anonImg}/>  

        <PersonnelCard 
            fullname="Emil VanPelt" 
            position="Student Archival Assistant" 
            linkHref="" 
            imgSrc={emilImg}/>  


        </div>
    </div>


</div>

    


</div>
</Layout>
